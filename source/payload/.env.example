# Copiez ce fichier sous le nom .env et remplacez les valeurs obligatoires.
POSTGRES_PASSWORD=remplacez-par-une-valeur-aleatoire-longue
HDP_LOCAL_TOKEN=remplacez-par-un-secret-aleatoire-d-au-moins-32-caracteres
HDP_SQL_PASSWORD=remplacez-par-un-second-secret-aleatoire-d-au-moins-32-caracteres
HDP_PORT=8080
HDP_AUTH_MODE=passkey
HDP_WEBAUTHN_RP_ID=localhost
HDP_WEBAUTHN_ORIGIN=http://localhost:8080
HDP_COOKIE_SECURE=false
HDP_ALLOWED_HOSTS=localhost,127.0.0.1,api

# ReliefWeb impose depuis le 01/11/2025 un appname pré-approuvé.
# Ne pas inventer de valeur. Demande : https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# HDX HAPI exige un app_identifier généré par le fournisseur.
# Procédure officielle : https://hdx-hapi.readthedocs.io/en/latest/getting-started/
HDX_HAPI_APP_IDENTIFIER=

GITHUB_TOKEN=
HDP_MAX_UPLOAD_BYTES=536870912
